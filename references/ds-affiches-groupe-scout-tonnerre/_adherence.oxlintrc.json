{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/layout/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bebas Neue|EB Garamond|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Bebas Neue, EB Garamond, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|maxWidth|note|align|style|key|ref|className|style|children)$/]",
        "message": "<BodyText> doesn't accept that prop. Declared props: children, size, color, maxWidth, note, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<BodyText> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<BodyText> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|date|prefix|value|color|align|style|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: kicker, date, prefix, value, color, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:ink|red|teal)$/]",
        "message": "<Countdown> color must be one of 'ink' | 'red' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Countdown> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|tone|style|key|ref|className|style|children)$/]",
        "message": "<DataTag> doesn't accept that prop. Declared props: index, label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|red)$/]",
        "message": "<DataTag> tone must be one of 'auto' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|weight|color|tag|tagIndex|align|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: width, weight, color, tag, tagIndex, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Divider> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fleur'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|style|key|ref|className|style|children)$/]",
        "message": "<Fleur> doesn't accept that prop. Declared props: size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GreetingBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|highlight|message|highlightColor|fleur|align|style|key|ref|className|style|children)$/]",
        "message": "<GreetingBlock> doesn't accept that prop. Declared props: lead, highlight, message, highlightColor, fleur, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GreetingBlock'] > JSXAttribute[name.name='highlightColor'] > Literal[value!=/^(?:ink|red|teal)$/]",
        "message": "<GreetingBlock> highlightColor must be one of 'ink' | 'red' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GreetingBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<GreetingBlock> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:cols|rows|nodes|inset|color|nodeColor|style|key|ref|className|style|children)$/]",
        "message": "<GridOverlay> doesn't accept that prop. Declared props: cols, rows, nodes, inset, color, nodeColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|org|submention|collaborator|connector|closer|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<HeaderBand> doesn't accept that prop. Declared props: eyebrow, org, submention, collaborator, connector, closer, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<HeaderBand> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderBand'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<HeaderBand> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:badgesSrc|height|caption|logo|align|style|key|ref|className|style|children)$/]",
        "message": "<PartnerRow> doesn't accept that prop. Declared props: badgesSrc, height, caption, logo, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerRow'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<PartnerRow> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|inset|grid|gridCols|gridRows|header|rail|footer|size|children|className|style|key|ref|className|style|children)$/]",
        "message": "<PosterFrame> doesn't accept that prop. Declared props: tone, inset, grid, gridCols, gridRows, header, rail, footer, size, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterFrame'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|cream|teal)$/]",
        "message": "<PosterFrame> tone must be one of 'white' | 'cream' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:platforms|handle|iconColor|iconSize|gap|style|key|ref|className|style|children)$/]",
        "message": "<SocialRail> doesn't accept that prop. Declared props: platforms, handle, iconColor, iconSize, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|index|key|ref|className|style|children)$/]",
        "message": "<SpecItem> doesn't accept that prop. Declared props: label, value, index."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|color|size|align|fleur|style|key|ref|className|style|children)$/]",
        "message": "<TitleBlock> doesn't accept that prop. Declared props: eyebrow, title, subtitle, color, size, align, fleur, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:red|ink|teal|white)$/]",
        "message": "<TitleBlock> color must be one of 'red' | 'ink' | 'teal' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md)$/]",
        "message": "<TitleBlock> size must be one of 'xl' | 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<TitleBlock> align must be one of 'left' | 'center' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "BodyText": {
